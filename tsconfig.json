{
  "compilerOptions": {
    "outDir": "dist",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["dom", "esnext"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src", "*.ts", "*.js", "scripts"],
  "exclude": ["node_modules", "dist", "output", "docs"]
}
